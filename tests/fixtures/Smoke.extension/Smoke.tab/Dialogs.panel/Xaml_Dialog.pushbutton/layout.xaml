<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smoke XAML Dialog" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <StackPanel Margin="16">
    <TextBlock Text="This window was loaded from layout.xaml in the bundle." TextWrapping="Wrap"/>
    <TextBlock Text="Type something:" Margin="0,12,0,4"/>
    <TextBox x:Name="NameBox" Height="24"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="OkButton" Content="OK" Width="72" Margin="0,0,8,0" IsDefault="True"/>
      <Button x:Name="CancelButton" Content="Cancel" Width="72" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
