<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Viewpoint Tracker" Width="560" Height="210"
        MinWidth="320" MinHeight="140"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True">
  <Grid Margin="24,16,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="Status" Grid.Row="0" Text=""
               FontSize="11" TextAlignment="Center" Opacity="0.75"/>

    <Viewbox Grid.Row="1" Margin="0,6,0,0" MaxHeight="88"
             HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="ViewName" Text="No viewpoint selected"
                 FontSize="32" FontWeight="SemiBold" TextAlignment="Center"
                 Background="Transparent" Cursor="Hand"/>
    </Viewbox>
  </Grid>
</Window>
