<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root" Margin="12" Focusable="True">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- No colours anywhere: the panel follows the Navisworks theme. The active
       target is shown bold, which reads in both themes. -->

  <!-- Row 0: which target, and where it is -->
  <StackPanel Grid.Row="0">
    <TextBlock x:Name="TargetName" Text="Box" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="Readout" Text="" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
    <Button x:Name="SectionOn" Content="Turn sectioning on" Margin="0,6,0,0"
            Padding="8,3,8,3" HorizontalAlignment="Left" Visibility="Collapsed"/>
  </StackPanel>

  <!-- Row 1: target buttons, 0 is the box, 1 to 6 the planes or faces -->
  <UniformGrid Grid.Row="1" Rows="1" Columns="7" Margin="0,10,0,0">
    <Button x:Name="TargetBox" Content="Box" Margin="1" Padding="0,3,0,3"/>
    <Button x:Name="Target1" Content="1" Margin="1" Padding="0,3,0,3"/>
    <Button x:Name="Target2" Content="2" Margin="1" Padding="0,3,0,3"/>
    <Button x:Name="Target3" Content="3" Margin="1" Padding="0,3,0,3"/>
    <Button x:Name="Target4" Content="4" Margin="1" Padding="0,3,0,3"/>
    <Button x:Name="Target5" Content="5" Margin="1" Padding="0,3,0,3"/>
    <Button x:Name="Target6" Content="6" Margin="1" Padding="0,3,0,3"/>
  </UniformGrid>

  <!-- Row 2: the nudge pad. One of the two is shown at a time. -->
  <Grid Grid.Row="2" Margin="0,8,0,0">
    <UniformGrid x:Name="PlanePad" Rows="1" Columns="2" Visibility="Collapsed">
      <Button x:Name="NudgeIn" Content="In  (Up)" Margin="1" Padding="0,6,0,6"/>
      <Button x:Name="NudgeOut" Content="Out  (Down)" Margin="1" Padding="0,6,0,6"/>
    </UniformGrid>
    <UniformGrid x:Name="BoxPad" Rows="2" Columns="3">
      <Button x:Name="MoveXMinus" Content="-X  (Left)" Margin="1" Padding="0,5,0,5"/>
      <Button x:Name="MoveYPlus" Content="+Y  (Up)" Margin="1" Padding="0,5,0,5"/>
      <Button x:Name="MoveZPlus" Content="+Z  (PgUp)" Margin="1" Padding="0,5,0,5"/>
      <Button x:Name="MoveXPlus" Content="+X  (Right)" Margin="1" Padding="0,5,0,5"/>
      <Button x:Name="MoveYMinus" Content="-Y  (Down)" Margin="1" Padding="0,5,0,5"/>
      <Button x:Name="MoveZMinus" Content="-Z  (PgDn)" Margin="1" Padding="0,5,0,5"/>
    </UniformGrid>
  </Grid>

  <!-- Row 3: the step -->
  <Grid Grid.Row="3" Margin="0,10,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="Step" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <TextBox x:Name="StepBox" Grid.Column="1" Text="100" VerticalAlignment="Center"
             Padding="4,2,4,2" MinWidth="60"/>
    <TextBlock x:Name="StepUnits" Grid.Column="2" Text="mm" VerticalAlignment="Center"
               Margin="6,0,6,0" Opacity="0.75"/>
    <Button x:Name="StepHalve" Grid.Column="3" Content="-" Width="28" Margin="1"
            ToolTip="Halve the step (minus key)"/>
    <Button x:Name="StepDouble" Grid.Column="4" Content="+" Width="28" Margin="1"
            ToolTip="Double the step (plus key)"/>
  </Grid>

  <!-- Row 4: the key legend -->
  <TextBlock x:Name="Hint" Grid.Row="4" Margin="0,10,0,0" FontSize="10.5" Opacity="0.6"
             TextWrapping="Wrap"
             Text="Click the panel, then: 0 to 6 pick a target, Tab cycles, Up and Down nudge a plane, arrows and PgUp/PgDn move the box, plus and minus change the step, Enter applies a typed step. Ctrl+Z undoes a nudge."/>
</Grid>
